set -eu

outdir="$HOME/ebooks"
verbose=0

usage() {
	echo "usage: ${0##*/} [-v] [-o dir] url" >&2
	exit 1
}

die() {
	echo "${0##*/}: $*" >&2
	exit 1
}

vlog() {
	[ "$verbose" -eq 1 ] && echo "${0##*/}: $*" >&2 || true
}

while getopts "o:v" opt; do
	case "$opt" in
	o) outdir="$OPTARG" ;;
	v) verbose=1 ;;
	*) usage ;;
	esac
done
shift $((OPTIND - 1))

[ $# -eq 1 ] || usage

for cmd in curl jq zip; do
	command -v "$cmd" >/dev/null 2>&1 || die "$cmd: not found"
done

url=${1%%\?*}
url=${url%/}
case "$url" in
*/read) ;;
*) url="$url/read" ;;
esac

tmpdir=$(mktemp -d)
trap 'rm -rf "$tmpdir"' EXIT INT TERM

mkdir -p "$tmpdir/epub/META-INF" "$tmpdir/epub/OEBPS"

vlog "fetching $url"
curl -fsSL -A "Mozilla/5.0" "$url" -o "$tmpdir/page.html" ||
	die "failed to fetch $url"

awk '
	match($0, /<script[^>]*id="reader-config"[^>]*>/) {
		s = substr($0, RSTART + RLENGTH)
		if (match(s, /<\/script>/)) {
			print substr(s, 1, RSTART - 1)
			exit
		}
		print s
		in_cfg = 1
		next
	}
	in_cfg {
		if (match($0, /<\/script>/)) {
			print substr($0, 1, RSTART - 1)
			exit
		}
		print
	}
' "$tmpdir/page.html" > "$tmpdir/config.json"

[ -s "$tmpdir/config.json" ] || die "reader-config not found"

opf_url=$(jq -r '.opfUrl' "$tmpdir/config.json")
base_url=${opf_url%/*}
title=$(jq -r '.title // .slug // "book"' "$tmpdir/config.json")
safe_title=$(printf '%s' "$title" | tr -d '\\/*?:"<>|' | sed 's/^[[:space:]]*//;s/[[:space:]]*$//')

mkdir -p "$outdir"
case "$outdir" in
/*) outpath="$outdir/$safe_title.epub" ;;
*) outpath="$PWD/$outdir/$safe_title.epub" ;;
esac

vlog "fetching manifest $opf_url"
curl -fsSL -A "Mozilla/5.0" "$opf_url" -o "$tmpdir/epub/OEBPS/content.opf" ||
	die "failed to fetch manifest"

awk '
	{
		line = $0
		while (match(line, /<item[^>]*href="[^"]+"/)) {
			tag = substr(line, RSTART, RLENGTH)
			sub(/.*href="/, "", tag)
			sub(/".*/, "", tag)
			print tag
			line = substr(line, RSTART + RLENGTH)
		}
	}
' "$tmpdir/epub/OEBPS/content.opf" | sort -u > "$tmpdir/raw_hrefs.txt"

[ -s "$tmpdir/raw_hrefs.txt" ] || die "empty manifest"

awk '
	BEGIN {
		for (i = 0; i < 256; i++) hex[sprintf("%02X", i)] = sprintf("%c", i)
	}
	{
		s = $0
		out = ""
		while (match(s, /%[0-9A-Fa-f][0-9A-Fa-f]/)) {
			out = out substr(s, 1, RSTART - 1) hex[toupper(substr(s, RSTART + 1, 2))]
			s = substr(s, RSTART + 3)
		}
		print out s
	}
' "$tmpdir/raw_hrefs.txt" > "$tmpdir/hrefs.txt"

export base_url tmpdir verbose
tr '\n' '\0' < "$tmpdir/raw_hrefs.txt" | xargs -0 -P 8 -I {} sh -c '
	raw="$1"
	dec=$(printf "%s\n" "$raw" | awk "
		BEGIN { for (i = 0; i < 256; i++) hex[sprintf(\"%02X\", i)] = sprintf(\"%c\", i) }
		{
			s = \$0; out = \"\"
			while (match(s, /%[0-9A-Fa-f][0-9A-Fa-f]/)) {
				out = out substr(s, 1, RSTART - 1) hex[toupper(substr(s, RSTART + 1, 2))]
				s = substr(s, RSTART + 3)
			}
			print out s
		}
	")
	[ "$verbose" -eq 1 ] && echo "marxistdotcom2epub: downloading $dec" >&2
	mkdir -p "$tmpdir/epub/OEBPS/$(dirname "$dec")"
	curl -fsSL -A "Mozilla/5.0" "$base_url/$raw" -o "$tmpdir/epub/OEBPS/$dec" ||
		echo "marxistdotcom2epub: skipped $dec" >&2
' _ {}

ncount=$(jq '.notes | length // 0' "$tmpdir/config.json")

if [ "$ncount" -gt 0 ]; then
	vlog "processing $ncount footnotes"
	first_xhtml=$(grep -E '\.(xhtml|html)$' "$tmpdir/hrefs.txt" | head -n 1 || true)
	notes_dir=""
	case "$first_xhtml" in
	*/*) notes_dir="${first_xhtml%/*}/" ;;
	esac
	notes_href="${notes_dir}notes.xhtml"

	jq -r '.notes | keys[]' "$tmpdir/config.json" > "$tmpdir/note_ids.txt"

	while IFS= read -r h; do
		case "$h" in
		*.xhtml|*.html) ;;
		*) continue ;;
		esac
		f="$tmpdir/epub/OEBPS/$h"
		[ -f "$f" ] || continue

		awk -v idfile="$tmpdir/note_ids.txt" '
			BEGIN {
				while ((getline id < idfile) > 0) notes[id] = 1
				close(idfile)
			}
			{
				if (!has_ns && $0 ~ /<html[^>]*xmlns:epub=/) has_ns = 1
				if (!has_ns && $0 ~ /<html([ >]|$)/) {
					sub(/<html/, "<html xmlns:epub=\"http://www.idpf.org/2007/ops\"")
					has_ns = 1
				}
				out = ""
				s = $0
				while (match(s, /href="#[^"]+"/)) {
					id = substr(s, RSTART + 7, RLENGTH - 8)
					rep = (id in notes) ? "href=\"notes.xhtml#" id "\"" : "href=\"#" id "\""
					out = out substr(s, 1, RSTART - 1) rep
					s = substr(s, RSTART + RLENGTH)
				}
				print out s
			}
		' "$f" > "$f.tmp" && mv "$f.tmp" "$f"
	done < "$tmpdir/hrefs.txt"

	mkdir -p "$tmpdir/epub/OEBPS/$(dirname "$notes_href")"
	{
		printf '<?xml version="1.0" encoding="utf-8"?>\n'
		printf '<html xmlns="http://www.w3.org/1999/xhtml" xmlns:epub="http://www.idpf.org/2007/ops" xml:lang="en">\n'
		printf '<head><title>Notes</title></head><body>\n'

		jq -r '
			.notes | to_entries[] |
			(.key | gsub("&"; "&amp;") | gsub("\""; "&quot;") | gsub("<"; "&lt;") | gsub(">"; "&gt;")) as $id |
			((.value | if type == "object" then (.html // .text // tostring) else tostring end)
				| gsub("&(?!(amp|lt|gt|quot|apos|#[0-9]+|#x[0-9a-fA-F]+);)"; "&amp;")
				| gsub("<(?<t>br|hr|img)(?<a>[^>]*)>"; "<\(.t)\(.a) />"; "i")
				| gsub("/\\s*/>"; "/>")
			) as $body |
			"<aside id=\"\($id)\" epub:type=\"footnote\">\($body)</aside>"
		' "$tmpdir/config.json"

		printf '</body></html>\n'
	} > "$tmpdir/epub/OEBPS/$notes_href"

	awk -v nh="$notes_href" '
		/<\/manifest>/ {
			print "  <item id=\"notes\" href=\"" nh "\" media-type=\"application/xhtml+xml\"/>"
		}
		/<\/spine>/ {
			print "  <itemref idref=\"notes\" linear=\"no\"/>"
		}
		{ print }
	' "$tmpdir/epub/OEBPS/content.opf" > "$tmpdir/epub/OEBPS/content.opf.tmp" &&
		mv "$tmpdir/epub/OEBPS/content.opf.tmp" "$tmpdir/epub/OEBPS/content.opf"
fi

printf 'application/epub+zip' > "$tmpdir/epub/mimetype"
cat << 'EOF' > "$tmpdir/epub/META-INF/container.xml"
<?xml version="1.0" encoding="UTF-8"?>
<container version="1.0" xmlns="urn:oasis:names:tc:opendocument:xmlns:container">
  <rootfiles><rootfile full-path="OEBPS/content.opf" media-type="application/oebps-package+xml"/></rootfiles>
</container>
EOF

vlog "packing $outpath"
rm -f "$outpath"
(
	cd "$tmpdir/epub"
	zip -X0 "$outpath" mimetype >/dev/null
	zip -rX9 "$outpath" META-INF OEBPS >/dev/null
)

echo "$outpath"
